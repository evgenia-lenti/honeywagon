{
  "mcpServers": {
    "notes": {
      "command": "mcp",
      "args": ["run", "${CLAUDE_PLUGIN_ROOT}/servers/notes_server.py"],
      "env": {
        "NOTES_DB": "${CLAUDE_PLUGIN_DATA}/notes.db"
      }
    },
    "team-wiki": {
      "type": "http",
      "url": "https://wiki.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${TEAM_WIKI_TOKEN}"
      }
    }
  }
}
