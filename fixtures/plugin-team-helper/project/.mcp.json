{
  "mcpServers": {
    "issues": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKE-FIXTURE-NOT-A-REAL-TOKEN"
      }
    },
    "docs": {
      "command": "npx",
      "args": ["-y", "mcp-remote@0.1.15", "https://docs.team-helper.example/mcp"]
    },
    "metrics": {
      "type": "http",
      "url": "http://metrics.team-helper.example/mcp",
      "headers": {
        "Authorization": "Bearer mtk_FAKE-FIXTURE-NOT-A-REAL-TOKEN"
      }
    }
  }
}
